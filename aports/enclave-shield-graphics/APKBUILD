pkgname=enclave-shield-graphics
pkgver=25.0.7
pkgrel=1
pkgdesc="Mesa OpenGL/Vulkan with guarded Shield operations and local CPU fallback"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="MIT AND SGI-B-2.0 AND BSL-1.0 AND LicenseRef-Enclave-Source-Available"
depends="vulkan-loader"
makedepends="build-base bison flex meson python3 py3-mako py3-packaging py3-yaml
 libdrm-dev expat-dev elfutils-dev libx11-dev libxext-dev libxfixes-dev libxxf86vm-dev
 libxrandr-dev libxshmfence-dev libxcb-dev xorgproto llvm22-dev json-c-dev
 zlib-dev zstd-dev wayland-dev wayland-protocols glslang-dev vulkan-loader-dev"
source="https://archive.mesa3d.org/mesa-25.0.7.tar.xz
 enclave-shield-graphics-0.1.0.tar"
builddir="$srcdir/mesa-$pkgver"
ldpath="/usr/lib/enclave-shield"
sonameprefix="$pkgname:"
options="!check" # standalone transport and installed API fixtures run in CI
prepare() {
    patch --batch --fuzz=0 -p1 < "$srcdir/enclave-shield-graphics-0.1.0/mesa-llvm22-orc.patch"
    patch --batch --fuzz=0 -p1 < "$srcdir/enclave-shield-graphics-0.1.0/mesa-orc-cache-lock.patch"
    patch --batch --fuzz=0 -p1 < "$srcdir/enclave-shield-graphics-0.1.0/mesa-prepass.patch"
    cp "$srcdir"/enclave-shield-graphics-0.1.0/shield_*.h src/gallium/frontends/lavapipe/
    cp "$srcdir"/enclave-shield-graphics-0.1.0/shield_*.c src/gallium/frontends/lavapipe/
}
build() {
    export PATH="$PATH:/usr/lib/llvm22/bin"
    meson setup build --prefix=/usr --libdir=lib/enclave-shield --datadir=share/enclave-shield --buildtype=release \
        -Dgallium-drivers=llvmpipe,zink -Dvulkan-drivers=swrast -Dplatforms=x11 \
        -Dglx=dri -Degl=enabled -Dglvnd=disabled -Dgbm=enabled \
        -Dgallium-va=disabled -Dgallium-vdpau=disabled -Dgallium-xa=disabled \
        -Dllvm=enabled -Dshared-llvm=enabled -Dbuild-tests=false -Dvideo-codecs=
    meson compile -C build -j 2
}
package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
    mkdir -p "$pkgdir/usr/share/enclave-shield/vulkan"
    python3 - "$pkgdir" <<'PY'
import json,pathlib,sys
root=pathlib.Path(sys.argv[1]); directory=root/'usr/share/enclave-shield/vulkan/icd.d'
files=list(directory.glob('lvp_icd*.json'));assert len(files)==1,files
icd=json.loads(files[0].read_text())
icd['ICD']['library_path']='/usr/lib/enclave-shield/libvulkan_lvp.so'
(root/'usr/share/enclave-shield/vulkan/icd.json').write_text(json.dumps(icd,indent=2)+'\n')
files[0].unlink()
PY
    rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/enclave-shield/pkgconfig"
    install -Dm644 "$srcdir/enclave-shield-graphics-0.1.0/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/Enclave-LICENSE"
}
