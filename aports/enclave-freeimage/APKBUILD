pkgname=enclave-freeimage
pkgver=3.19.0
pkgrel=0
_commit=b1613452a0c3849d43ac877b154cf51ff9e078d3
pkgdesc="Visual Pinball's pinned FreeImage fork with half-float textures"
url="https://github.com/toxieainc/freeimage"
arch="x86_64 riscv64"
license="GPL-2.0-only AND BSD-3-Clause AND IJG AND libpng-2.0 AND Zlib"
makedepends="cmake samurai python3"
subpackages="$pkgname-dev"
source="$pkgname-$_commit.tar.gz::https://codeload.github.com/toxieainc/freeimage/tar.gz/$_commit
 roundtrip.cpp"
builddir="$srcdir/freeimage-$_commit"
prepare() {
    python3 - <<'PORT'
from pathlib import Path
p=Path('CMakeLists.txt');s=p.read_text()
s=s.replace('set(FREEIMAGE_OUTPUT_NAME "freeimage")','set(FREEIMAGE_OUTPUT_NAME "enclave-freeimage")')
s=s.replace('install(FILES source/FreeImage.h DESTINATION ${CMAKE_INSTALL_PREFIX}/include)',
            'install(FILES Source/FreeImage.h DESTINATION ${CMAKE_INSTALL_PREFIX}/include/enclave-freeimage)')
p.write_text(s)
PORT
}
build() {
    case "$CARCH" in x86_64) target=x64;; riscv64) target=riscv64;; *) return 1;; esac
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DPLATFORM=linux -DARCH="$target" -DBUILD_STATIC=OFF -DBUILD_SHARED=ON
    cmake --build build -j2
}
check() {
    c++ -std=c++17 -ISource "$srcdir/roundtrip.cpp" -Lbuild -lenclave-freeimage -o build/roundtrip
    LD_LIBRARY_PATH="$builddir/build" ./build/roundtrip
}
package() {
    DESTDIR="$pkgdir" cmake --install build
    python3 - "$pkgdir/usr/share/licenses/$pkgname" <<'COPY'
from pathlib import Path
import shutil,sys
out=Path(sys.argv[1])
for p in Path('.').rglob('*'):
 if p.is_file() and 'build' not in p.parts and p.name.lower().startswith(('license','copying','copyright')):
  dst=out/p;dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dst)
COPY
}
