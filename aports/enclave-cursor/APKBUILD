pkgname=enclave-cursor
pkgver=0.1.0
pkgrel=0
pkgdesc="Persistent authenticated desktop cursor owner"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="LicenseRef-Enclave-Source-Available"
source="$pkgname-$pkgver.tar"
builddir="$srcdir/$pkgname-$pkgver"
options="!check" # integration checks run after signed repository installation
depends="python3"
makedepends="libx11-dev"
build() {
    cc $CFLAGS -Wall -Wextra -Werror cursor-owner.c $LDFLAGS -lX11 -o cursor-owner
}
package() {
    install -Dm755 cursor-owner "$pkgdir/usr/libexec/enclave-os/cursor/cursor-owner"
    install -m755 start.py supervise.py "$pkgdir/usr/libexec/enclave-os/cursor/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
sha512sums="af9fcd3abc4f2e5c3672f7c800b4d320beca223f792e8de8b4845c47f42d5934aadfc61b4d00eef7c71f883e32621fc8bf5d8edfbeccc5ed688aa819310340df  enclave-cursor-0.1.0.tar"
