pkgname=enclave-pocl
pkgver=6.0
pkgrel=1
_commit=952bc559f790e5deb5ae48692c4a19619b53fcdc
pkgdesc="Shield CPU OpenCL fallback with event, half and vectorizer fixes"
url="https://portablecl.org"
arch="x86_64 riscv64"
license="MIT"
makedepends="cmake samurai clang18 clang18-dev clang18-libclang llvm18-dev llvm18-static llvm18-test-utils llvm18-gtest hwloc-dev zstd-dev
 libxml2-dev opencl-headers opencl-icd-loader-dev enclave-llvm-spirv18 python3"
depends="clang18 enclave-llvm-spirv18"
ldpath="/usr/lib/enclave-pocl/lib:/usr/lib/enclave-pocl/lib/pocl"
sonameprefix="$pkgname:"
options="!check" # installed OpenCL behavioral fixtures run below
source="pocl-$_commit.tar.gz::https://codeload.github.com/pocl/pocl/tar.gz/$_commit
 pocl-callback-errors.patch
 pocl-half-convert.patch
 pocl-half-tanh.patch
 pocl-half-images.patch
 pocl-vectorizer.patch
 cstdint.patch
 worker-stack.patch"
builddir="$srcdir/pocl-$_commit"
build() {
    export PATH="/usr/lib/llvm18/bin:$PATH"
    case "$CARCH" in
        x86_64) cpu=x86-64 ;;
        riscv64) cpu=generic-rv64 ;;
        *) return 1 ;;
    esac
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/lib/enclave-pocl -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_RPATH="/usr/lib/enclave-pocl/lib:/usr/lib/enclave-pocl/lib/pocl" \
        -DWITH_LLVM_CONFIG=/usr/lib/llvm18/bin/llvm-config \
        -DENABLE_ICD=ON -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF \
        -DENABLE_HOST_CPU_DEVICES=ON -DENABLE_CUDA=OFF -DENABLE_VULKAN=OFF \
        -DENABLE_HSA=OFF -DENABLE_ALMAIF_DEVICE=OFF -DENABLE_TCE=OFF \
        -DENABLE_REMOTE_CLIENT=OFF -DENABLE_REMOTE_SERVER=OFF \
        -DENABLE_SPIRV=ON -DLLVM_SPIRV=/usr/bin/llvm-spirv-18 \
        -DPOCL_INSTALL_ICD_VENDORDIR=/etc/OpenCL/vendors \
        -DKERNELLIB_HOST_CPU_VARIANTS=native -DLLC_HOST_CPU="$cpu" -DSTATIC_LLVM=OFF
    cmake --build build -j2
}
package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    rm -rf "$pkgdir/usr/lib/enclave-pocl/share/doc" "$pkgdir/usr/lib/enclave-pocl/lib/pkgconfig"
}
