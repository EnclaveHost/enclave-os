pkgname=enclave-visual-pinball-x
pkgver=0.1.0
pkgrel=0
pkgdesc="Enclave Pinball launcher, retained example table and shared desktop settings"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="GPL-3.0-or-later AND LicenseRef-VPinball-Legacy"
depends="enclave-vpx-core enclave-desktop enclave-shield-graphics xdotool"
options="!check" # Installed launcher and table rendering are exercised by vpx-runtime.yml.
source="exampleTable.vpx::https://raw.githubusercontent.com/vpinball/vpinball/5a81d4e3292ff4adba7327017dd1ab840765b60a/src/assets/exampleTable.vpx
 enclave-vpinball vpinball.ini vpinball.desktop"
package() {
    install -Dm755 "$srcdir/enclave-vpinball" "$pkgdir/usr/bin/enclave-vpinball"
    install -Dm644 "$srcdir/vpinball.ini" "$pkgdir/etc/enclave-os/vpinball.ini"
    install -Dm644 "$srcdir/vpinball.desktop" "$pkgdir/usr/share/applications/vpinball.desktop"
    install -Dm644 "$srcdir/exampleTable.vpx" "$pkgdir/usr/share/enclave-os/vpinball/exampleTable.vpx"
}
