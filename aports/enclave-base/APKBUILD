pkgname=enclave-base
pkgver=0.1.0
pkgrel=0
pkgdesc="Shared Enclave OS configuration"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="LicenseRef-Enclave-Source-Available"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="!check" # integration checks run after signed repository installation
package() {
    mkdir -p "$pkgdir/etc" "$pkgdir/usr/share/licenses/$pkgname"
    cp -a etc/. "$pkgdir/etc/"
    install -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
