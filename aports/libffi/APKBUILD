# Based on Alpine 3.24 libffi; enable upstream static executable trampolines.
# RISC-V backport: libffi upstream c9b2a8a4ceb2fa1f46c0200592562677214084fd.
pkgname=libffi
pkgver=3.5.2
pkgrel=101
pkgdesc="portable, high level programming interface to various calling conventions."
url="https://sourceware.org/libffi/"
arch="x86_64 riscv64"
license="MIT"
depends_dev="linux-headers"
makedepends_build="texinfo autoconf automake libtool"
checkdepends="dejagnu"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc"
source="https://github.com/libffi/libffi/releases/download/v$pkgver/libffi-$pkgver.tar.gz
	fix-tests-fortify.patch
	riscv-static-tramp.patch
	"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--enable-pax_emutramp \
		--enable-portable-binary \
		--enable-exec-static-tramp
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

