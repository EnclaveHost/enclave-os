pkgname=enclave-shield-ir-reference
pkgver=0.1.0
pkgrel=0
pkgdesc="Audited integer GEMM structural reference for the Shield IR compiler"
url="https://github.com/EnclaveHost/enclave-os"
arch="noarch"
license="LicenseRef-Enclave-Source-Available"
depends="enclave-shield-opencl"
options="!check !strip" # Installed positive and adversarial IR tests run in CI.
source="gemm-reference.bc gemm-reference.spv"
builddir="$srcdir"
package() {
    local dest="$pkgdir/usr/lib/enclave-shield-opencl"
    install -Dm644 gemm-reference.bc "$dest/gemm-reference.bc"
    install -m644 gemm-reference.spv "$dest/"
    install -Dm644 /src/components/shield-opencl/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 /src/components/shield-opencl/gemm_i8_cuda.cu "$dest/gemm-reference.cu"
}
