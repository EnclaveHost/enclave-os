pkgname=enclave-openarena
pkgver=0.8.8
pkgrel=0
pkgdesc="OpenArena with Enclave absolute-menu and relative-game input bridge"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="GPL-2.0-or-later"
depends="enclave-desktop $pkgname-data"
makedepends="sdl2-dev mesa-dev curl-dev openal-soft-dev libjpeg-turbo-dev libvorbis-dev opusfile-dev zlib-dev binutils"
subpackages="$pkgname-data::noarch"
options="!check" # signed install and isolated startup checks are in CI
source="https://deb.debian.org/debian/pool/main/i/ioquake3/ioquake3_1.36+u20250316.526edd3+dfsg.orig.tar.xz
 https://deb.debian.org/debian/pool/main/o/openarena/openarena_0.8.8+dfsg.orig.tar.xz
 https://deb.debian.org/debian/pool/main/o/openarena/openarena_0.8.8+dfsg-8.debian.tar.xz
 ioquake3-enclave.patch
 enclave-openarena
 defaults.cfg
 openarena.desktop
 https://deb.debian.org/debian/pool/main/o/openarena-textures/openarena-081-textures_0.8.5split-15_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-players/openarena-081-players_0.8.5split-15_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-088-data/openarena-088-data_0.8.8-14_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-data/openarena-data_0.8.5split-16_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-maps/openarena-081-maps_0.8.5split-15_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-085-data/openarena-085-data_0.8.5split-16_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-misc/openarena-081-misc_0.8.5split-15_all.deb
 https://deb.debian.org/debian/pool/main/o/openarena-players-mature/openarena-081-players-mature_0.8.5split-15_all.deb
"
builddir="$srcdir/ioquake3-1.36+u20250316.526edd3"
prepare() {
    patch --batch --fuzz=0 -p1 < "$srcdir/ioquake3-enclave.patch"
    cd "$srcdir/oa-0.8.8"
    while read -r p; do
        patch --batch --fuzz=0 -p1 < "$srcdir/debian/patches/$p"
    done < "$srcdir/debian/patches/series"
}
build() {
    make ARCH="$CARCH" BUILD_CLIENT=1 BUILD_SERVER=0 BUILD_GAME_SO=0 BUILD_GAME_QVM=0 \
        BUILD_MISSIONPACK=0 USE_INTERNAL_LIBS=0 USE_LOCAL_HEADERS=0 \
        USE_CURL_DLOPEN=0 USE_OPENAL_DLOPEN=0 HAVE_VM_COMPILED= \
        CFLAGS="$CFLAGS -DWITH_OPENARENA -fsigned-char" LDFLAGS="$LDFLAGS" release
    for variant in current compat; do
        compatible=0
        [ "$variant" != compat ] || compatible=1
        make -C "$srcdir/oa-0.8.8" ARCH="$CARCH" BR="build/$variant" \
            BUILD_CLIENT=0 BUILD_SERVER=0 BUILD_GAME_SO=1 BUILD_GAME_QVM=0 BUILD_MISSIONPACK=1 \
            OPENARENA_081_COMPATIBLE="$compatible" VERSION="$pkgver/Enclave" \
            USE_INTERNAL_SPEEX=0 USE_INTERNAL_ZLIB=0 USE_LOCAL_HEADERS=0 SDL_CFLAGS= \
            CFLAGS="$CFLAGS -fsigned-char -fcommon" LDFLAGS="$LDFLAGS -Wl,-z,defs" release
    done
}
package() {
    runtime="$pkgdir/usr/lib/enclave-os/openarena"
    content="$pkgdir/usr/share/enclave-os/openarena"
    mkdir -p "$runtime/baseoa/pak0" "$runtime/baseoa/pak6-patch088" "$runtime/missionpack" "$content"
    install -m755 build/release-linux-$CARCH/ioquake3.$CARCH "$runtime/ioquake3"
    install -m755 build/release-linux-$CARCH/renderer_*.so "$runtime/"
    install -m755 "$srcdir"/oa-0.8.8/build/compat/baseq3/*.so "$runtime/baseoa/pak0/"
    install -m755 "$srcdir"/oa-0.8.8/build/current/baseq3/*.so "$runtime/baseoa/pak6-patch088/"
    install -m755 "$srcdir"/oa-0.8.8/build/current/missionpack/*.so "$runtime/missionpack/"
    ln -s pak6-patch088 "$runtime/baseoa/pak6-patch085"
    for module in "$runtime"/baseoa/pak6-patch088/*.so; do
        ln -s "pak6-patch088/${module##*/}" "$runtime/baseoa/${module##*/}"
    done
    mkdir -p "$srcdir/content"
    for archive in "$srcdir"/openarena-*.deb; do
        member=$(ar t "$archive" | grep '^data\.tar\.')
        ar p "$archive" "$member" | tar -x -C "$srcdir/content"
    done
    cp -a "$srcdir/content/usr/share/games/openarena/." "$content/"
    for directory in baseoa missionpack; do
        for asset in "$content/$directory"/*.pk3; do
            [ -f "$asset" ] || continue
            ln -s "/usr/share/enclave-os/openarena/$directory/${asset##*/}" "$runtime/$directory/${asset##*/}"
        done
    done
    install -Dm755 "$srcdir/enclave-openarena" "$pkgdir/usr/bin/enclave-openarena"
    install -Dm644 "$srcdir/defaults.cfg" "$content/defaults.cfg"
    install -Dm644 "$srcdir/openarena.desktop" "$pkgdir/usr/share/applications/enclave-openarena.desktop"
    mkdir -p "$pkgdir/usr/share/licenses/$pkgname"
    cp -a "$srcdir/content/usr/share/doc/." "$pkgdir/usr/share/licenses/$pkgname/"
    install -m644 COPYING.txt "$pkgdir/usr/share/licenses/$pkgname/ioquake3-COPYING.txt"
}
data() {
    pkgdesc="Pinned full OpenArena assets"
    depends=
    amove usr/share/enclave-os/openarena
    amove usr/share/licenses/enclave-openarena
}
