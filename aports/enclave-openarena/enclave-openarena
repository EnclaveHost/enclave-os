#!/bin/sh
set -eu
. /usr/libexec/enclave-os/game-env
mkdir -p "$HOME/.cache" "$HOME/.openarena/baseoa"
export SHIELD_INPUT_STATE="$HOME/.cache/openarena-input-state"
if [ ! -e "$HOME/.openarena/baseoa/q3config.cfg" ]; then
    cp /usr/share/enclave-os/openarena/defaults.cfg "$HOME/.openarena/baseoa/q3config.cfg"
fi
exec /usr/lib/enclave-os/openarena/ioquake3 \
    +set com_basegame baseoa +set fs_basepath /usr/lib/enclave-os/openarena \
    +set com_homepath .openarena +set com_legacyprotocol 71 +set com_protocol 71 \
    +set sv_master1 dpmaster.deathmask.net +set cl_motd 0 \
    +set vm_ui 0 +set vm_cgame 0 +set vm_game 0 \
    +set ttycon 0 +set r_allowSoftwareGL 1 +set m_pitch 0.022 +set in_absoluteMenu 1 "$@"
