pkgname=enclave-desktop
pkgver=0.1.0
pkgrel=0
pkgdesc="Shared lightweight Enclave desktop settings"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="LicenseRef-Enclave-Source-Available AND CC-BY-SA-3.0"
source="$pkgname-$pkgver.tar"
builddir="$srcdir/$pkgname-$pkgver"
options="!check" # integration checks run after signed repository installation
depends="enclave-cursor fluxbox dbus xterm font-dejavu font-misc-misc"
makedepends="libx11-dev"
build() {
    cc $CFLAGS -Wall -Wextra window-helper.c $LDFLAGS -lX11 -o window-helper
}
package() {
    mkdir -p "$pkgdir/usr/share/enclave-os/skel" "$pkgdir/usr/bin"
    cp -a skel/. "$pkgdir/usr/share/enclave-os/skel/"
    install -Dm644 game-env "$pkgdir/usr/libexec/enclave-os/game-env"
    install -Dm755 games-menu.py "$pkgdir/usr/libexec/enclave-os/games-menu.py"
    install -Dm755 seed-home.py "$pkgdir/usr/libexec/enclave-os/seed-home.py"
    install -Dm755 window-helper "$pkgdir/usr/libexec/enclave-os/window-helper"
    mkdir -p "$pkgdir/usr/share/fluxbox/styles/Enclave"
    cp -a styles/Enclave/. "$pkgdir/usr/share/fluxbox/styles/Enclave/"
    install -m755 bin/* "$pkgdir/usr/bin/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
sha512sums="91febd2ba68f8e2ae6b99a7d24e4c913c6b3af977d774781f3a9f1e48d36678b78f4a3f40dcf96b2fc254fb040f0f9247ff22961b2f99ed34f26af4f392a90f0  enclave-desktop-0.1.0.tar"
