pkgname=enclave-freedoom
pkgver=0.1.0
pkgrel=0
pkgdesc="Enclave fbDOOM with FreeDoom Phase 1 and OPL audio"
url="https://github.com/EnclaveHost/enclave-os"
arch="x86_64 riscv64"
license="LicenseRef-Enclave-Source-Available"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="!check" # integration checks run after signed repository installation
license="GPL-2.0-only AND BSD-3-Clause AND LGPL-2.1-or-later"
depends="pulseaudio-utils"
build() {
    make -j2 CROSS_COMPILE= NOSDL=1 CFLAGS="$CFLAGS -DNORMALUNIX -DLINUX -include music_compat.h" LDFLAGS="$LDFLAGS"
}
package() {
    install -Dm755 fbdoom "$pkgdir/usr/bin/enclave-xdoom"
    install -Dm755 enclave-doom "$pkgdir/usr/bin/enclave-doom"
    install -Dm644 assets/freedoom1.wad "$pkgdir/usr/share/games/doom/freedoom1.wad"
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
    install -m644 COPYING.opl3 assets/COPYING.freedoom "$pkgdir/usr/share/licenses/$pkgname/"
}
sha512sums="8a1e4d0a8a36f7d252e7da4bd8595657f9777b7b514cf92e38bac3fd67eb0fddac461f4b3f751170f5df1c3028634f99ba0565b27c480d3f385afab0581b7abd  enclave-freedoom-0.1.0.tar.gz"
