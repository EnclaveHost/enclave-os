pkgname=enclave-winevbs
pkgver=0.10.2
pkgrel=0
_commit=e8f15a759c345f8ff535bacf2fe6045cc59f5f8c
pkgdesc="Portable Visual Pinball VBScript runtime"
url="https://github.com/vpinball/libwinevbs"
arch="x86_64 riscv64"
license="LGPL-2.1-only AND GPL-2.0-only"
makedepends="cmake samurai bison python3 linux-headers"
subpackages="$pkgname-dev"
source="$pkgname-$_commit.tar.gz::https://codeload.github.com/vpinball/libwinevbs/tar.gz/$_commit"
builddir="$srcdir/libwinevbs-$_commit"
prepare() {
    default_prepare
    sed -i 's/-Wno-format/-Wformat/' CMakeLists.txt
}
build() {
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DPLATFORM=linux \
        -DARCH="$CARCH" -DBUILD_SHARED=ON -DBUILD_STATIC=OFF -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j2
}
check() {
    ./build/winevbs_test >build/test.log 2>&1
    python3 - <<'CHECK'
from pathlib import Path
s=Path('build/test.log').read_text()
for expected in ['2 + 3 * 4 = 14','Hello from VBScript!','Count: 5 squared = 25','Upper: HELLO WORLD','Done.']:
    assert expected in s, s
for failure in ['Expression failed:', 'Print test failed:', 'Loop test failed:', 'TypeName test failed:']:
    assert failure not in s, s
CHECK
}
package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 README.md "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
sha512sums="36d5241bdbefe712f7090b5e0870e3e84910c9f0a1f9c1249b1ca4a06c9d62303eb9ac886890c6886dfdbdbb7c64d17837e5438ff2a01f9358ca9ddb68fa4b81  enclave-winevbs-e8f15a759c345f8ff535bacf2fe6045cc59f5f8c.tar.gz"
