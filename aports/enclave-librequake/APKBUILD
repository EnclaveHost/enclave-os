pkgname=enclave-librequake
pkgver=0.09_beta
pkgrel=0
pkgdesc="LibreQuake full campaign with Enclave desktop and Shield settings"
url="https://github.com/lavenderdotpet/LibreQuake"
arch="x86_64 riscv64"
license="GPL-2.0-or-later AND BSD-3-Clause"
depends="enclave-desktop"
makedepends="sdl2-dev mesa-dev libmad-dev libvorbis-dev flac-dev libmikmod-dev opusfile-dev"
source="https://deb.debian.org/debian/pool/main/q/quakespasm/quakespasm_0.96.3+dfsg.orig.tar.xz
 librequake-v0.09-beta-full.zip::https://github.com/lavenderdotpet/LibreQuake/releases/download/v0.09-beta/full.zip
 enclave-librequake
 autoexec.cfg
 librequake.desktop"
builddir="$srcdir/quakespasm-0.96.3"
options="!check" # installed engine startup tested in disposable Xvfb; real Shield qualification is separate
build() {
    make -C Quake USE_SDL2=1 DO_USERDIRS=1 USE_CODEC_FLAC=1 USE_CODEC_MIKMOD=1 USE_CODEC_OPUS=1
}
package() {
    install -Dm755 Quake/quakespasm "$pkgdir/usr/libexec/enclave-os/quakespasm"
    mkdir -p "$pkgdir/usr/share/enclave-os/librequake"
    cp -a "$srcdir/full/id1" "$pkgdir/usr/share/enclave-os/librequake/"
    install -Dm644 "$srcdir/autoexec.cfg" "$pkgdir/usr/share/enclave-os/librequake/autoexec.cfg"
    install -Dm755 "$srcdir/enclave-librequake" "$pkgdir/usr/bin/enclave-librequake"
    install -Dm644 "$srcdir/librequake.desktop" "$pkgdir/usr/share/applications/enclave-librequake.desktop"
    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/quakespasm-COPYING"
}
