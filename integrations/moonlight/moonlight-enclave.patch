+// Opt-in local companion carries only a mode over the existing pinned TLS channel.
+// Apply transitions on SDL's input thread. Never activate or raise the window.
+void SdlInputHandler::pollShieldCaptureState()
+{
+    static const QByteArray path = qgetenv("SHIELD_CAPTURE_STATE");
+    static Uint32 lastPoll = 0;
+    static int previous = -1;
+    if (path.isEmpty() || !m_Window) return;
+    Uint32 now = SDL_GetTicks();
+    if (now - lastPoll < 100) return;
+    lastPoll = now;
+    QFileInfo info(QString::fromUtf8(path));
+    QFile file(QString::fromUtf8(path));
+    const qint64 age = info.lastModified().msecsTo(QDateTime::currentDateTime());
+    QByteArray value;
+    if (info.isFile() && !info.isSymLink() && age >= 0 && age < 3000 && file.open(QIODevice::ReadOnly))
+        value = file.read(32);
+    const bool relative = value == "relative\n";
+    // Ignore missing, stale or malformed input hints; cursor ownership is fixed.
+    if (value != "relative\n" && value != "absolute\n" && value != "menu\n" && value != "fallback\n") return;
+    int desired = relative ? 1 : value == "menu\n" ? 3 : 0;
+    // A manual toggle or release stays in effect until the guest changes state.
+    if (desired == previous) return;
+    previous = desired;
+    setCaptureActive(false);
+    m_AbsoluteMouseMode = !relative;
+    m_MouseCursorCapturedVisibilityState = SDL_DISABLE;
+    const Uint32 flags = SDL_GetWindowFlags(m_Window);
+    if ((flags & SDL_WINDOW_INPUT_FOCUS) && !(flags & SDL_WINDOW_MINIMIZED)) {
+        setCaptureActive(true);
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Shield guest mouse mode: %s (focused=%d)",
+                relative ? "relative" : value == "menu\n" ? "menu" : "absolute", !!(flags & SDL_WINDOW_INPUT_FOCUS));
+}
