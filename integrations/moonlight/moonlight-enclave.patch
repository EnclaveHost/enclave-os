index 0000000..612e81b
--- /dev/null
+++ b/app/streaming/audio/renderers/audioqueuebudget.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <cstdint>
+
+inline bool audioFitsBudget(std::uint32_t queuedBytes, int incomingBytes,
+                            std::uint32_t frameBytes, std::uint32_t frameMs,
+                            std::uint32_t pendingMs)
+{
+    if (incomingBytes < 0 || !frameBytes || !frameMs || frameMs > 80 || pendingMs > 80)
+        return false;
+    const std::uint64_t bytes = std::uint64_t(queuedBytes) + incomingBytes;
+    const std::uint64_t duration = (bytes * frameMs + frameBytes - 1) / frameBytes;
+    return duration + pendingMs <= 80;
+}
