+// Op-level accelerator for CPU runners: a backend that claims individual ops
+// (supports_op) while the CPU computes the rest, scheduled per graph. Set by
+// sd_set_accel_backend, or loaded once from the SD_ACCEL_BACKEND module path.
+// A requested accelerator that cannot be loaded is a hard failure for every
+// CPU runner (sd_accel_backend_failed), never a silent all-CPU run.
+static ggml_backend_t sd_accel_backend_ = nullptr;
+static bool sd_accel_failed_            = false;
+static bool sd_accel_env_checked_       = false;
+static std::mutex sd_accel_mu_;
+
+void sd_set_accel_backend(ggml_backend_t backend) {
+    std::lock_guard<std::mutex> lk(sd_accel_mu_);
+    sd_accel_backend_     = backend;
+    sd_accel_failed_      = false;
+    sd_accel_env_checked_ = true;
+}
+
+bool sd_load_accel_backend(const char* path) {
+    ggml_backend_reg_t reg = path != nullptr ? ggml_backend_load(path) : nullptr;
+    ggml_backend_dev_t dev = nullptr;
+    if (reg != nullptr) {
+        for (size_t i = 0; i < ggml_backend_reg_dev_count(reg); i++) {
+            if (ggml_backend_dev_type(ggml_backend_reg_dev_get(reg, i)) == GGML_BACKEND_DEVICE_TYPE_ACCEL) {
+                dev = ggml_backend_reg_dev_get(reg, i);
+                break;
+            }
+        }
+    }
+    ggml_backend_t backend = dev != nullptr ? ggml_backend_dev_init(dev, nullptr) : nullptr;
+    std::lock_guard<std::mutex> lk(sd_accel_mu_);
+    sd_accel_env_checked_ = true;
+    if (backend == nullptr) {
+        LOG_ERROR("accelerator backend '%s' did not load an ACCEL device", path ? path : "(null)");
+        sd_accel_backend_ = nullptr;
+        sd_accel_failed_  = true;
+        return false;
+    }
+    LOG_INFO("accelerator backend: %s (%s)", ggml_backend_name(backend), path);
+    sd_accel_backend_ = backend;
+    sd_accel_failed_  = false;
+    return true;
+}
+
+ggml_backend_t sd_get_accel_backend() {
+    {
+        std::lock_guard<std::mutex> lk(sd_accel_mu_);
+        if (sd_accel_env_checked_) {
+            return sd_accel_backend_;
+        }
+    }
+    const char* path = getenv("SD_ACCEL_BACKEND");
+    if (path == nullptr || *path == '\0') {
+        std::lock_guard<std::mutex> lk(sd_accel_mu_);
+        sd_accel_env_checked_ = true;
+        return sd_accel_backend_;
+    }
+    sd_load_accel_backend(path);
+    std::lock_guard<std::mutex> lk(sd_accel_mu_);
+    return sd_accel_backend_;
+}
+
+// Leading rows of the joint [caption, image] sequence that an accelerator must keep
+// on the CPU (set by a model while it builds its graph; 0 = none). Caption-token
+// activations are 10-200x the image tokens' in Z-Image, so a fixed-point offload
+// calibrated for both rounds the image rows coarsely; with the caption rows local,
+// its exponent fits the image rows. The row count is already visible as the batch.
+static int sd_accel_lead_rows_ = 0;
+void sd_set_accel_lead_rows(int n) {
+    sd_accel_lead_rows_ = n > 0 ? n : 0;
+    ggml_backend_t be  = sd_get_accel_backend();
+    if (be == nullptr) {
+        return;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(be);
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto fn = reg ? (void (*)(int))ggml_backend_reg_get_proc_address(reg, "ggml_backend_shielded_set_lead_rows") : nullptr;
+    if (fn != nullptr) {
+        fn(sd_accel_lead_rows_);
+    }
+}
+int sd_get_accel_lead_rows() {
+    return sd_accel_lead_rows_;
+}
+
+bool sd_accel_backend_failed() {
+    sd_get_accel_backend();
+    std::lock_guard<std::mutex> lk(sd_accel_mu_);
+    return sd_accel_failed_;
+}
+
 sd_graph_eval_callback_t sd_get_backend_eval_callback() {
     return sd_backend_eval_cb;
 }
