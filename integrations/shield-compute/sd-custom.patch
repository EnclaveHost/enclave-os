+// ---- TEST-ONLY: emulate a Shield site's activation encoding on the CPU (SD_SHIELD_EMULATE=<calib>) ----
+// Before a calibrated linear, its input is replaced by a copy whose rows past the lead rows (the
+// caption rows a Shield backend keeps exact) are rounded to round(x * 2^af) / 2^af, outlier
+// channels exact: the activation half of the masked offload's arithmetic, with no worker and
+// none of its memory. Inert unless the env var names a calibration file.
+struct SdShieldEmuSite {
+    int af = 0;
+    std::vector<char> outlier;   // per input channel
+};
+__STATIC_INLINE__ const SdShieldEmuSite* sd_shield_emu_site(const std::string& weight_name) {
+    static std::map<std::string, SdShieldEmuSite> sites;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded           = true;
+        const char* path = getenv("SD_SHIELD_EMULATE");
+        if (path && *path) {
+            std::ifstream f(path);
+            std::string line;
+            while (std::getline(f, line)) {
+                if (line.rfind("site ", 0) != 0) continue;
+                std::istringstream is(line.substr(5));
+                std::string name;
+                int af = 0, n = 0;
+                is >> name >> af >> n;
+                SdShieldEmuSite site;
+                site.af = af;
+                for (int i = 0; i < n; i++) {
+                    int64_t o = 0;
+                    is >> o;
+                    if (o >= (int64_t)site.outlier.size()) site.outlier.resize((size_t)o + 1, 0);
+                    site.outlier[(size_t)o] = 1;
+                }
+                sites[name] = site;
+            }
+            LOG_INFO("SD_SHIELD_EMULATE: %zu sites from %s", sites.size(), path);
+        }
+    }
+    if (sites.empty()) return nullptr;
+    std::string key = weight_name;   // the Shield group key: w3 -> w1, k/v -> q, up -> gate
+    for (auto& m : std::vector<std::pair<std::string, std::string>>{{"feed_forward.w3", "feed_forward.w1"}, {"self_attn.k_proj", "self_attn.q_proj"},
+                                                                     {"self_attn.v_proj", "self_attn.q_proj"}, {"mlp.up_proj", "mlp.gate_proj"}}) {
+        size_t at = key.find(m.first);
+        if (at != std::string::npos) { key.replace(at, m.first.size(), m.second); break; }
+    }
+    auto it = sites.find(key);
+    return it == sites.end() ? nullptr : &it->second;
+}
+__STATIC_INLINE__ void sd_shield_emu_op(ggml_tensor* dst, const ggml_tensor* a, int ith, int nth, void* ud) {
+    const SdShieldEmuSite* site = (const SdShieldEmuSite*)ud;
+    const int64_t K = a->ne[0], rows = ggml_nrows(a), per = a->ne[1];
+    const int lead  = sd_get_accel_lead_rows();
+    const double sc = ldexp(1.0, site->af);
+    for (int64_t r = ith; r < rows; r += nth) {
+        const float* x = (const float*)((const char*)a->data + r * a->nb[1]);
+        float* y       = (float*)((char*)dst->data + r * dst->nb[1]);
+        const bool exact_row = (r % per) < lead;
+        for (int64_t k = 0; k < K; k++) {
+            const bool out = k < (int64_t)site->outlier.size() && site->outlier[(size_t)k];
+            y[k]           = (exact_row || out) ? x[k] : (float)(std::nearbyint(x[k] * sc) / sc);
+        }
+    }
+}
