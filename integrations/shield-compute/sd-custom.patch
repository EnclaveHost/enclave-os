+    // apply_rope's interleaved graph (permute+cont, permute+cont, two ggml_repeat of a size-1
+    // inner dim, two broadcast muls, an add) in ONE pass that also writes the [d_head, L,
+    // n_head*N] layout the attention reads. Per element it does exactly what that graph does:
+    // y[2j+r] = (x[2j] * M[r][0]) + (x[2j+1] * M[r][1]), two roundings for the products and one
+    // for the sum (this file is built without FMA contraction, and ggml's mul/add round
+    // separately), so the output is bit-identical. On a CPU-only diffusion pass (a Shield
+    // guest) the repeats alone were ~1 s of every Z-Image 512px step. Opt-in: SD_ROPE_FUSED=1
+    // (a custom op runs on the CPU; on a GPU backend it would force a copy round trip).
+    __STATIC_INLINE__ void rope_fused_interleaved_op(ggml_tensor* dst, int ith, int nth, void*) {
+        const ggml_tensor* x  = dst->src[0];
+        const ggml_tensor* pe = dst->src[1];
+        const int64_t d_head = x->ne[0], n_head = x->ne[1], L = x->ne[2], N = x->ne[3];
+        const int64_t half = d_head / 2, rows = L * n_head * N;
+        const int64_t per = (rows + nth - 1) / nth, r0 = per * ith, r1 = std::min(rows, r0 + per);
+        for (int64_t row = r0; row < r1; row++) {
+            const int64_t l = row % L, hp = row / L, head = hp % n_head, n = hp / n_head;
+            const char* xr = (const char*)x->data + head * x->nb[1] + l * x->nb[2] + n * x->nb[3];
+            float* yr      = (float*)((char*)dst->data + l * dst->nb[1] + hp * dst->nb[2]);
+            for (int64_t j = 0; j < half; j++) {
+                const float x0  = *(const float*)(xr + (2 * j) * x->nb[0]);
+                const float x1  = *(const float*)(xr + (2 * j + 1) * x->nb[0]);
+                const char* pj  = (const char*)pe->data + j * pe->nb[2] + l * pe->nb[3];   // M[r][c] at c*nb0 + r*nb1
+                const float m00 = *(const float*)pj, m01 = *(const float*)(pj + pe->nb[0]);
+                const float m10 = *(const float*)(pj + pe->nb[1]), m11 = *(const float*)(pj + pe->nb[0] + pe->nb[1]);
+                const float a0 = x0 * m00, b0 = x1 * m01;
+                const float a1 = x0 * m10, b1 = x1 * m11;
+                yr[2 * j]     = a0 + b0;
+                yr[2 * j + 1] = a1 + b1;
+            }
+        }
+    }
