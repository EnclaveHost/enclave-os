+/* Opt-in authenticated companion reads this state; no input is accepted here. */
+static void IN_PublishStreamCapture(void)
+{
+    static int lastTime = -1000;
+    static int lastMode = -1;
+    const char *path = getenv("SHIELD_INPUT_STATE");
+    char temporary[1024], data[64];
