{
  "version": 1,
  "base": "alpine-3.24",
  "resolution": [
    960,
    600
  ],
  "features": {
    "core": [
      "alpine-baselayout",
      "busybox",
      "musl",
      "ca-certificates-bundle",
      "enclave-base"
    ],
    "desktop": [
      "enclave-desktop",
      "enclave-cursor",
      "fluxbox",
      "xorg-server",
      "xf86-input-libinput",
      "xterm",
      "font-dejavu",
      "xauth",
      "xsetroot",
      "dbus",
      "dbus-x11",
      "pulseaudio"
    ],
    "browser": [
      "firefox-esr"
    ],
    "freedoom": [
      "enclave-freedoom"
    ],
    "agent": [
      "python3",
      "curl",
      "git",
      "jq",
      "nodejs",
      "xdotool",
      "xprop",
      "xwininfo",
      "xdpyinfo",
      "xrandr",
      "xset"
    ],
    "web-desktop": [
      "novnc",
      "websockify",
      "x11vnc"
    ]
  },
  "presets": {
    "minimal": [
      "core"
    ],
    "desktop": [
      "core",
      "desktop",
      "browser",
      "freedoom",
      "agent",
      "web-desktop"
    ],
    "full": [
      "core",
      "desktop",
      "freedoom",
      "agent",
      "web-desktop",
      "enclave-browser",
      "shield-graphics",
      "shield-compute",
      "moonlight-server",
      "openarena",
      "librequake",
      "visual-pinball-x",
      "openhv"
    ]
  },
  "pending_features": [
    "enclave-browser",
    "shield-graphics",
    "shield-compute",
    "moonlight-server",
    "openarena",
    "librequake",
    "visual-pinball-x",
    "openhv"
  ],
  "exclude_packages": [
    "py3-numpy-tests"
  ]
}
