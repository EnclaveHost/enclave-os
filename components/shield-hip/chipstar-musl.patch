+
+inline int chipCaptureStack(void **frames, int capacity) {
+  struct Stack { void **frames; int count; int capacity; } stack{frames, 0, capacity};
+  _Unwind_Backtrace([](_Unwind_Context *context, void *opaque) {
+    auto *s = static_cast<Stack *>(opaque);
+    if (s->count == s->capacity) return _URC_END_OF_STACK;
+    auto pc = _Unwind_GetIP(context);
+    if (pc) s->frames[s->count++] = reinterpret_cast<void *>(pc);
+    return _URC_NO_REASON;
+  }, &stack);
+  return stack.count;
+}
 
