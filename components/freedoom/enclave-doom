#!/bin/sh
# No xsetroot cursor replacement: the persistent cursor owner survives game exit.
set -eu
: "${DISPLAY:?desktop session required}"
: "${XAUTHORITY:?authenticated desktop session required}"
mkdir -p "$HOME/.local/share/enclave-doom"
cd "$HOME/.local/share/enclave-doom"
exec /usr/bin/enclave-xdoom -mb 64 -uncapped -fpsmax 60 -scaling 3 \
    -iwad /usr/share/games/doom/freedoom1.wad "$@"
