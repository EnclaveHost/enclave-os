#!/bin/sh
set -eu
export GDK_BACKEND=x11
mkdir -p "$HOME/.mozilla/firefox/enclave"
browser=firefox-esr
class=firefox
if command -v enclave-firefox >/dev/null 2>&1; then
    browser=enclave-firefox
    class=enclave-browser
fi
helper=/usr/libexec/enclave-os/window-helper
if "$helper" list "$class" >/dev/null 2>&1; then
    "$helper" show "$class" >/dev/null 2>&1 || true
    [ "$#" -gt 0 ] || exit 0
    exec "$browser" --profile "$HOME/.mozilla/firefox/enclave" --new-tab "$@"
fi
exec "$browser" --profile "$HOME/.mozilla/firefox/enclave" "$@"
